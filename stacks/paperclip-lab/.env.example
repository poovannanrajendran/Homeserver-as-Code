COMPOSE_PROJECT_NAME=paperclip-locallab

# Paperclip package version. Use "latest" for lab testing or pin a version after validation.
PAPERCLIP_VERSION=latest
PAPERCLIP_INSTANCE_ID=paperclip-locallab
PAPERCLIP_HOST_PORT=3102
PAPERCLIP_PUBLIC_URL=http://localhost:3102
PAPERCLIP_THEME_NAME=paperclip-locallab
PAPERCLIP_BRAND_COLOR="#0f766e"
PAPERCLIP_BOOTSTRAP_INVITE_HOURS=72

# Self-contained lab database. Change this before first start if you want a custom password.
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=paperclip

# Optional. If empty, the container generates and persists one in the Paperclip instance .env.
PAPERCLIP_AGENT_JWT_SECRET=

# Optional provider auth for the in-container CLIs.
# Claude Code: use ANTHROPIC_API_KEY or the interactive /login flow.
ANTHROPIC_API_KEY=
# Codex CLI: set OPENAI_API_KEY to use API auth inside the container.
OPENAI_API_KEY=
# Gemini CLI: set GEMINI_API_KEY for API auth, or use interactive Google login.
GEMINI_API_KEY=
# Optional provider auth for OpenRouter-backed workflows.
OPENROUTER_API_KEY=

# Optional X/Twitter API credentials if you later wire an X publishing bridge.
X_API_KEY=
X_API_SECRET=

# Remote n8n MCP bridge. Put the bearer token only in stacks/paperclip-lab/.env, never in git.
N8N_MCP_URL=http://192.168.1.20:5678/mcp-server/http
N8N_MCP_BEARER_TOKEN=

# Local Mac MCP gateway. Start a local HTTP/streamable MCP aggregator on this port if needed.
LOCAL_MAC_MCP_URL=http://host.docker.internal:8765/mcp

# Local Ollama on the Mac. Docker Desktop exposes the host as host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Grounding pack mounted read-only into the Paperclip container.
POOVI_GROUNDING_PACK_PATH=/Users/poovannanrajendran/Documents/workarea/Poovi_GroudningPack
