{
  "id": null,
  "uid": "homeserver-health",
  "title": "HomeServer Health",
  "tags": ["homelab", "health", "rag"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Collector Freshness (sec)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "time() - max(obs_health_collector_run_timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 1200 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Proxmox HTTPS",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "max(obs_proxmox_https_up)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "VM Ping Health (%)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * avg(obs_ping_up{target=~\"192.168.1.20|192.168.1.24|192.168.1.30\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "VM SSH Health (%)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * avg(obs_ssh_up{target=~\"192.168.1.20|192.168.1.24|192.168.1.30\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "HTTP Probe Success (%)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: HTTP probes",
          "url": "http://192.168.1.30:9090/graph?g0.expr=100%20*%20avg(last_over_time(probe_success%7Bjob%3D%22blackbox_http%22%7D%5B2m%5D))&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "100 * avg(last_over_time(probe_success{job=\"blackbox_http\"}[2m]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "TCP Probe Success (%)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: TCP probes",
          "url": "http://192.168.1.30:9090/graph?g0.expr=100%20*%20avg(last_over_time(probe_success%7Bjob%3D%22blackbox_tcp_infra%22%7D%5B2m%5D))&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "100 * avg(last_over_time(probe_success{job=\"blackbox_tcp_infra\"}[2m]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Supabase DB Check",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: Supabase DB check",
          "url": "http://192.168.1.30:9090/graph?g0.expr=max(obs_postgres_query_ok%7Bdb%3D%22supabase_postgres%22%7D)&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "max(obs_postgres_query_ok{db=\"supabase_postgres\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN/UNSET" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Postgres: lloyds_digest",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: lloyds_digest",
          "url": "http://192.168.1.30:9090/graph?g0.expr=max(obs_postgres_query_ok%7Bdb%3D%22lloyds_digest_local%22%7D)&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "max(obs_postgres_query_ok{db=\"lloyds_digest_local\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Postgres: memex",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: memex",
          "url": "http://192.168.1.30:9090/graph?g0.expr=max(obs_postgres_query_ok%7Bdb%3D%22memex_local%22%7D)&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "max(obs_postgres_query_ok{db=\"memex_local\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Postgres: youtube_liked_videos",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: youtube_liked_videos",
          "url": "http://192.168.1.30:9090/graph?g0.expr=max(obs_postgres_query_ok%7Bdb%3D%22youtube_liked_videos_remote%22%7D)&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "max(obs_postgres_query_ok{db=\"youtube_liked_videos_remote\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Mongo Atlas TCP",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: Mongo Atlas TCP",
          "url": "http://192.168.1.30:9090/graph?g0.expr=max(obs_mongo_atlas_tcp_up)&g0.tab=1"
        }
      ],
      "targets": [
        { "expr": "max(obs_mongo_atlas_tcp_up)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Disk Usage % (/ and /var)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "obs_filesystem_used_percent{mount=~\"/|/var\"}",
          "legendFormat": "{{mount}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres DB Size (bytes)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "obs_postgres_db_size_bytes",
          "legendFormat": "{{db}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Probe Duration by Endpoint (s)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_duration_seconds{job=~\"blackbox_http|blackbox_tcp_infra\"}",
          "legendFormat": "{{job}} | {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "table",
      "title": "Cron Jobs Count by Host",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 19 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "obs_cron_jobs_total",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "host": 1,
              "source": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "jobs"
            }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP Checks Down",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 19 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: HTTP checks down",
          "url": "http://192.168.1.30:9090/graph?g0.expr=sum((probe_success%7Bjob%3D%22blackbox_http%22%7D%20%3D%3D%200))&g0.tab=1"
        }
      ],
      "targets": [
        {
          "expr": "sum((probe_success{job=\"blackbox_http\"} == 0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "TCP Checks Down",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 19 },
      "datasource": "Prometheus",
      "links": [
        {
          "title": "Drill down: TCP checks down",
          "url": "http://192.168.1.30:9090/graph?g0.expr=sum((probe_success%7Bjob%3D%22blackbox_tcp_infra%22%7D%20%3D%3D%200))&g0.tab=1"
        }
      ],
      "targets": [
        {
          "expr": "sum((probe_success{job=\"blackbox_tcp_infra\"} == 0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "table",
      "title": "HTTP Drilldown Details",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox_http\"} == 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "status"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "instance": "endpoint",
              "status": "down"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "endpoint", "desc": false }]
      }
    },
    {
      "type": "table",
      "title": "TCP Drilldown Details",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox_tcp_infra\"} == 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "status"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "instance": "endpoint",
              "status": "down"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "endpoint", "desc": false }]
      }
    }
  ]
}
