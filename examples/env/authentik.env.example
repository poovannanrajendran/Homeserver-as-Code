TZ=America/Chicago

# Bind addresses for host ports. Use 0.0.0.0 for LAN + Tailscale access.
# If you want to restrict to LAN only, set them to the host's LAN IP.
AUTHENTIK_BIND_IP=0.0.0.0

# Authentik core
AUTHENTIK_SECRET_KEY=CHANGE_ME_50PLUS_CHARS

# Postgres (matches stacks/authentik/docker-compose.yml defaults)
AUTHENTIK_POSTGRESQL__HOST=postgresql
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME_LONG_RANDOM

# Redis (matches stacks/authentik/docker-compose.yml)
AUTHENTIK_REDIS__HOST=redis

# Bind ports (published to localhost only by default)
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9444
