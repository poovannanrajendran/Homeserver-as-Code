# Outline (self-hosted) - base config
TZ=America/Chicago

# Bind address for the host port. Use 0.0.0.0 for LAN + Tailscale access.
# If you want to restrict to LAN only, set it to the host's LAN IP.
OUTLINE_BIND_IP=0.0.0.0

# External URL users will browse to. Pick one:
# - LAN:      http://<docker-host-lan-ip-or-dns>:3010
# - Tailscale:http://docker-host-01.<tailnet>.ts.net:3010
URL=http://<docker-host-lan-ip-or-dns>:3010

# Host port binding
OUTLINE_HTTP_PORT=3010

# Required secrets (generate strong random strings; do not keep CHANGE_ME in production)
SECRET_KEY=CHANGE_ME_32PLUS_CHARS
UTILS_SECRET=CHANGE_ME_32PLUS_CHARS

# Database/Redis (defaults match the compose stack)
POSTGRES_USER=outline
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=outline
DATABASE_URL=postgres://outline:CHANGE_ME_LONG_RANDOM@postgres:5432/outline
REDIS_URL=redis://redis:6379

# Storage
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# Auth (OIDC). Recommended: Authentik.
# See docs/outline.md for Authentik setup + the exact redirect URL to register.
OIDC_DISPLAY_NAME=Family Login
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_AUTH_URI=http://<auth-host>:9000/application/o/authorize/
OIDC_TOKEN_URI=http://<auth-host>:9000/application/o/token/
OIDC_USERINFO_URI=http://<auth-host>:9000/application/o/userinfo/
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES=openid profile email
# Optional. Authentik logout URLs depend on your app/provider slug and flow config.
# OIDC_LOGOUT_URI=

# Optional: lock down signups; rely on IdP membership/invites
DISABLE_SIGNUP=true
